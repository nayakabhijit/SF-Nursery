<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Expense_Entry_Compact</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One record per amount spent on an Expense: a day&apos;s cost for Daily expenses, or a month&apos;s cost for Monthly expenses. Deducted from gross profit in the Profit &amp; Loss summary.</description>
