<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Price_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>Purchase Price must be 0 or more.</description>
    <errorConditionFormula>Purchase_Price__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Purchase_Price__c</errorDisplayField>
    <errorMessage>Purchase Price cannot be negative.</errorMessage>
</ValidationRule>
