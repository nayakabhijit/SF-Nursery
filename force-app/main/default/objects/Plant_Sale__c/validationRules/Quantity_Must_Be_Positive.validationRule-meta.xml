<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantity_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Quantity Sold must be greater than 0.</description>
    <errorConditionFormula>Quantity_Sold__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Quantity_Sold__c</errorDisplayField>
