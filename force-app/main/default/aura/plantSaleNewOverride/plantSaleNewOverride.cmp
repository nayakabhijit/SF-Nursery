<aura:component implements="lightning:actionOverride,lightning:hasPageReference" access="global">
    <aura:attribute name="plantId" type="String" />
    <aura:attribute name="show" type="Boolean" default="false" />

    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <!-- Override components are reused between navigations: re-initialise on each open. -->
    <aura:handler name="change" value="{!v.pageReference}" action="{!c.init}" />

    <aura:if isTrue="{!v.show}">
        <c:plantSaleForm defaultPlantId="{!v.plantId}" />
    </aura:if>
</aura:component>
